generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
}

model SensorData {
  id                 String   @id @default(uuid())
  soilMoisture       Float
  terrainInclination Float
  rainVolume         Float
  groundVibration    Float
  riskLevel          Int
  statusColor        String   // "Verde", "Amarelo", "Laranja", "Vermelho"
  createdAt          DateTime @default(now())
}

model EmergencyProtocol {
  id           String   @id @default(uuid())
  protocolCode String   @unique // Generated unique protocol
  riskLevel    Int
  status       String   @default("Em análise") // "Em análise", "Equipe enviada", "Finalizado"
  description  String?
  createdAt    DateTime @default(now())
}

enum Role {
  ADMIN
  OPERATOR
}
