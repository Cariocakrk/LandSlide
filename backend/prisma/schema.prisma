generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        String   @default("OPERATOR")
  phoneNumber String?
  cep         String?
  createdAt   DateTime @default(now())
}

model SensorData {
  id                 String   @id @default(uuid())
  soilMoisture       Float
  terrainInclination Float
  rainVolume         Float
  groundVibration    Float
  riskLevel          Int
  statusColor        String   // "Verde", "Amarelo", "Laranja", "Vermelho"
  createdAt          DateTime @default(now())
}

model EmergencyProtocol {
  id           String   @id @default(uuid())
  protocolCode String   @unique // Generated unique protocol
  riskLevel    Int
  status       String   @default("Em análise") // "Em análise", "Equipe enviada", "Finalizado"
  description  String?
  createdAt    DateTime @default(now())
}

model AlertDispatch {
  id           String   @id @default(uuid())
  protocolCode String
  cep          String
  numResidents Int
  channel      String   // "WhatsApp" | "SMS"
  status       String   // "ENVIADO" | "FALHOU"
  message      String
  createdAt    DateTime @default(now())
}

