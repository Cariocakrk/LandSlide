generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        String   @default("OPERATOR")
  phoneNumber String?
  cep         String?
  twoFactorCode    String?
  twoFactorExpires DateTime?
  createdAt        DateTime @default(now())
}

model SensorData {
  id                 String   @id @default(uuid())
  sensorId           String?  // Identificador do sensor IoT
  soilMoisture       Float
  terrainInclination Float
  rainVolume         Float
  groundVibration    Float
  riskLevel          Int
  statusColor        String   // "Verde", "Amarelo", "Laranja", "Vermelho"
  createdAt          DateTime @default(now())
}

model EmergencyProtocol {
  id           String          @id @default(uuid())
  protocolCode String          @unique // Generated unique protocol
  riskLevel    Int
  status       String          @default("Em análise") // "Em análise", "Equipe enviada", "Finalizado"
  description  String?
  createdAt    DateTime        @default(now())
  alerts       AlertDispatch[]
}

model AlertDispatch {
  id           String            @id @default(uuid())
  protocolCode String
  cep          String
  numResidents Int
  channel      String            // "WhatsApp" | "SMS"
  status       String            // "ENVIADO" | "FALHOU"
  message      String
  createdAt    DateTime          @default(now())
  protocol     EmergencyProtocol @relation(fields: [protocolCode], references: [protocolCode])
}

